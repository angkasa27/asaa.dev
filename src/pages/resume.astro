---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/navigation/Navigation.astro";
import Logo from "../components/resume/Logo.astro";
import {
  EXPERIENCE,
  EDUCATION,
  PUBLICATIONS,
  AWARDS,
} from "@/constants/resume";

const dateRange = (start: string, end: string) =>
  start && end ? `${start} — ${end}` : start || end || "";
---

<BaseLayout
  title="About — Dimas Angkasa"
  description="Software Engineer specializing in frontend development and enterprise systems."
>
  <Navigation>
    <main class="space-y-14 min-h-[calc(100dvh-var(--spacing)*66)]">
      {/* Header */}
      <div class="sm:pt-12 space-y-2 text-center">
        <h1 class="text-center animate-on-load">More about me</h1>
        <p
          class="text-pretty font-sans text-sm sm:text-base leading-6 text-muted-foreground text-center max-w-xl mx-auto animate-on-load"
          style="animation-delay: 80ms"
        >
          Software Engineer specializing in frontend architecture, enterprise
          system design, and building high-polish web experiences.
        </p>
      </div>

      {/* Where I've Worked - Experience Timeline */}
      <section data-reveal class="space-y-6">
        <h2>Where I've Worked</h2>

        <div class="relative pl-6 pt-1">
          {/* Continuous vertical timeline line rail */}
          <div
            class="absolute left-[7px] top-2.5 bottom-2.5 w-px bg-border"
            aria-hidden="true"
          >
          </div>

          <div class="space-y-8">
            {
              EXPERIENCE.map((job, index) => (
                <div class="relative pl-2">
                  {/* Dot Node ON the timeline line mathematically centered using left-[7.5px] -translate-x-1/2 */}
                  <div
                    class="absolute left-[-17px] top-2.5 size-2.5 rounded-full bg-foreground border-2 border-background ring-1 ring-border z-10 -translate-x-1/2"
                    aria-hidden="true"
                  />

                  <div class="space-y-2.5">
                    {/* 16:9 Company Logo AT TOP */}
                    <div>
                      <Logo
                        name={job.company}
                        logo={job.logo}
                        kind="company"
                        class="w-32 sm:w-36 aspect-video rounded-lg border border-border bg-background shadow-xs"
                      />
                    </div>

                    {/* Header OF THE EXPERIENCE UNDER LOGO */}
                    <div class="space-y-1">
                      <h3 class="text-base sm:text-lg font-bold text-foreground tracking-tight leading-snug">
                        {job.company}
                      </h3>
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-block rounded-md bg-secondary text-secondary-foreground text-xs font-medium px-2 py-0.5">
                          {job.position}
                        </span>
                        {dateRange(job.startDate, job.endDate) && (
                          <span class="font-mono text-xs text-muted-foreground">
                            {dateRange(job.startDate, job.endDate)}
                          </span>
                        )}
                      </div>
                      <p class="text-xs sm:text-sm text-muted-foreground font-sans">
                        {job.location}
                      </p>
                    </div>

                    {/* Bullet Points */}
                    {job.bullets.length > 0 && (
                      <ul class="mt-2 space-y-1.5 text-xs sm:text-sm text-muted-foreground leading-relaxed pl-4 list-disc marker:text-muted-foreground/50">
                        {job.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    )}

                    {/* Dashed divider between experience items */}
                    {index < EXPERIENCE.length - 1 && (
                      <div class="border-b border-dashed border-border/60 pt-6" />
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {/* Where I Learned - Education Single Column */}
      <section data-reveal class="space-y-6">
        <h2>Where I Learned</h2>

        <div class="space-y-6">
          {
            EDUCATION.map((edu) => (
              <div class="flex items-start gap-3.5">
                <Logo
                  name={edu.school}
                  logo={edu.logo}
                  kind="school"
                  class="size-11 shrink-0 rounded-xl border border-border bg-background p-1 shadow-xs"
                />
                <div class="min-w-0 flex-1 space-y-1">
                  <h3 class="font-bold text-base sm:text-lg text-foreground">
                    {edu.degree}
                  </h3>
                  <p class="text-sm text-muted-foreground">
                    {edu.school}
                    {dateRange(edu.startDate, edu.endDate) && (
                      <span class="font-mono text-xs text-muted-foreground/80 ml-2">
                        · {dateRange(edu.startDate, edu.endDate)}
                      </span>
                    )}
                  </p>
                  {edu.gpa && (
                    <p class="font-mono text-xs text-muted-foreground/80 pt-0.5">
                      GPA {edu.gpa}
                    </p>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      {/* Published Work - Publications Single Column */}
      <section data-reveal class="space-y-6">
        <h2>Published Work</h2>

        <div class="space-y-6">
          {
            PUBLICATIONS.map((pub) => (
              <div class="flex items-start gap-3.5">
                <div class="size-11 shrink-0 rounded-xl border border-border bg-secondary/30 grid place-items-center text-foreground">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5 text-muted-foreground"
                    aria-hidden="true"
                  >
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" x2="8" y1="13" y2="13" />
                    <line x1="16" x2="8" y1="17" y2="17" />
                    <line x1="10" x2="8" y1="9" y2="9" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1 space-y-1">
                  <h3 class="font-bold text-base sm:text-lg text-foreground">
                    {pub.url ? (
                      <a
                        href={pub.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 hover:underline"
                      >
                        {pub.title}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-3.5 text-muted-foreground shrink-0"
                          aria-hidden="true"
                        >
                          <path d="M15 3h6v6" />
                          <path d="M10 14 21 3" />
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        </svg>
                      </a>
                    ) : (
                      pub.title
                    )}
                  </h3>
                  <p class="text-xs sm:text-sm text-muted-foreground font-sans">
                    {pub.publisher}
                    {pub.date && (
                      <span class="font-mono text-xs text-muted-foreground/80 ml-2">
                        · {pub.date}
                      </span>
                    )}
                  </p>
                  <p class="text-xs sm:text-sm text-muted-foreground/80 leading-relaxed pt-1">
                    {pub.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- {/* Wins & Recognition - Awards Single Column */}
      <section data-reveal class="space-y-6">
        <h2>Wins & Recognition</h2>

        <div class="space-y-6">
          {
            AWARDS.map((award) => (
              <div class="flex items-start gap-3.5">
                <div class="size-11 shrink-0 rounded-xl border border-border bg-secondary/30 grid place-items-center text-foreground">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-5 text-muted-foreground"
                    aria-hidden="true"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                </div>

                <div class="min-w-0 flex-1 space-y-1">
                  <h3 class="font-bold text-base sm:text-lg text-foreground">
                    {award.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-muted-foreground">
                    {award.issuer}
                    {award.date && (
                      <span class="font-mono text-xs text-muted-foreground/80 ml-2">
                        · {award.date}
                      </span>
                    )}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </section> -->
    </main>
  </Navigation>
</BaseLayout>
