---
import ProjectCard from "./ProjectCard.astro";
import { PROJECTS } from "@/constants/projects";

const highlightedProjects = PROJECTS.filter((project) => project.highlight);
---

<section id="project" class="space-y-6">
  <div class="space-y-2 text-center" data-reveal>
    <div
      class="rounded-md bg-foreground text-background px-2.5 py-1 text-xs sm:text-sm font-medium mx-auto w-fit"
    >
      Epic Stuff 🔥
    </div>
    <h2 class="text-center">Highlighted Projects</h2>
    <p
      class="text-pretty font-sans text-sm sm:text-base leading-6 text-muted-foreground text-center max-w-lg mx-auto"
    >
      Building seamless and visually engaging web experiences is my passion.
      Explore more of my projects at{" "}
      <a href="/projects" class="dark:text-white text-foreground underline font-medium">
        projects page
      </a>
    </p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    {highlightedProjects.map((project, i) => (
      <div data-reveal data-reveal-delay={i * 80}>
        <ProjectCard project={project} />
      </div>
    ))}
  </div>
</section>
