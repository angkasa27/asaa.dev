---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  kind: "company" | "school";
  logo?: string;
  class?: string;
}

const { name, kind, logo, class: className = "" } = Astro.props;

const toSlug = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "");

// glob paths must be static literals, so both directories are declared up front
const companyLogos = import.meta.glob(
  "/src/assets/companies/*.{png,jpg,jpeg,webp,svg}",
  { eager: true, import: "default" },
) as Record<string, ImageMetadata>;

const schoolLogos = import.meta.glob(
  "/src/assets/schools/*.{png,jpg,jpeg,webp,svg}",
  { eager: true, import: "default" },
) as Record<string, ImageMetadata>;

const dirLogos = kind === "company" ? companyLogos : schoolLogos;
const logoKeys = Object.keys(dirLogos);

const findImage = () => {
  if (logo) {
    const exactMatch = logoKeys.find((key) => key.endsWith(`/${logo}`));
    if (exactMatch) return dirLogos[exactMatch];
  }
  const slug = toSlug(name);
  const candidateNames = [slug, slug.replace(/^pt-/, "")];
  for (const candidate of candidateNames) {
    const match = logoKeys.find((key) => {
      const filename = key.split("/").pop()?.split(".")[0] || "";
      return filename === candidate || filename.startsWith(candidate);
    });
    if (match) return dirLogos[match];
  }
  return null;
};

const image = findImage();

// fallback keeps the same footprint as a real logo, so dropping files in shifts nothing
const monogram = name
  .replace(/^(PT\.?|CV\.?)\s+/i, "")
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0])
  .join("")
  .toUpperCase();
---

<div
  class:list={["shrink-0 overflow-hidden border bg-white shadow-xs", className]}
>
  {
    image ? (
      <Image
        src={image}
        alt={`${name} logo`}
        format="webp"
        quality={90}
        loading="lazy"
        decoding="async"
        class="size-full object-contain object-center"
      />
    ) : (
      <span
        class="font-mono text-xs font-semibold text-muted-foreground"
        aria-hidden="true"
      >
        {monogram}
      </span>
    )
  }
</div>
